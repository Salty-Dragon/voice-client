{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warcryer",
  "version": "0.8.8",
  "identifier": "org.warcryer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warcryer",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream",
        "dragDropEnabled": false
      },
      {
        "label": "strip",
        "create": false,
        "title": "Warcryer strip",
        "url": "index.html",
        "width": 300,
        "height": 34,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "warcryer"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQkJBNEY5NTMxNkRGNEYKUldSUDN4WlQrYVM3VWZ0M2hZZ2JpNDdhajVzSDVmUnZSRDdBTTVrSFExWit1TFBWME9ReTZadnQK",
      "endpoints": [
        "https://ignite.v1rtopia.com/api/app/update?v={{current_version}}&target={{target}}&arch={{arch}}",
        "https://github.com/Warcryer/client/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
